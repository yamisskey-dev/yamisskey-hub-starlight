---
import { Icon } from '@astrojs/starlight/components';

interface Props {
	icon: string;
	title: string;
	href: string;
	description?: string;
}

const { icon, title, href, description } = Astro.props;
// スキーム付き（https:, minecraft: など）は外部リンク扱い
const external = /^[a-z][a-z0-9+.-]*:/i.test(href);
---

<a
	class="yami-link-card not-content"
	{href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener' : undefined}
>
	<span class="head">
		<img class="icon" src={icon} alt="" width="24" height="24" loading="lazy" />
		<span class="title">{title}</span>
		<Icon name={external ? 'external' : 'right-arrow'} class="arrow" size="1.1em" />
	</span>
	{description && <span class="description">{description}</span>}
</a>

<style>
	.yami-link-card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background-color: var(--yami-card-bg);
		color: inherit;
		text-decoration: none;
		transition: background-color 0.15s ease;
	}
	.yami-link-card:hover {
		background-color: var(--yami-card-hover-bg);
	}
	.head {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--sl-text-lg);
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.icon {
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 0.375rem;
		object-fit: contain;
	}
	.arrow {
		margin-inline-start: auto;
		color: var(--sl-color-gray-3);
	}
	.description {
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-3);
	}
</style>
